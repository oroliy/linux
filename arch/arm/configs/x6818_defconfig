CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_NEXELL=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_AEABI=y
CONFIG_HIGHMEM=y
CONFIG_VMSPLIT_2G=y
CONFIG_VFP=y
CONFIG_NEON=y
# The current Nexell stop_machine path cannot safely change early section
# permissions while all A53 CPUs are online.
# CONFIG_STRICT_KERNEL_RWX is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
# IPv6 SIT init currently deadlocks during x6818 netdevice registration.
# IPv4 networking does not require this tunnel driver on the board.
# CONFIG_IPV6_SIT is not set
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_NEXELL=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_NEXELL=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_NEXELL=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VIDEO_NEXELL_S5P6818=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_NEXELL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# The U-Boot load address is 0x48000000, which is outside the first 128 MiB
# of the board's RAM at 0x40000000.  Do not infer PHYS_OFFSET from zImage PC.
# CONFIG_AUTO_ZRELADDR is not set
CONFIG_PHYS_OFFSET=0x40000000
CONFIG_COMMON_CLK_NEXELL=y
CONFIG_RESET_NEXELL=y
CONFIG_NEXELL_TIMER=y
CONFIG_WATCHDOG=y
CONFIG_NEXELL_WDT=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_UARTS=6
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PINCTRL_NEXELL=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_CMDLINE="console=ttySAC0,115200n8 earlycon=s5p6818,mmio,0xc00a1000"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
