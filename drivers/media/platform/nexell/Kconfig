config VIDEO_NEXELL_CAPTURE
	tristate "Nexell S5P6818 CSI-2/VIP capture"
	depends on VIDEO_DEV && OF && HAS_DMA
	depends on ARCH_NEXELL_S5P6818 || COMPILE_TEST
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select V4L2_FWNODE
	select VIDEOBUF2_DMA_CONTIG
	help
	  CSI-2 receiver and VIP0 DMA capture for the S5P6818. Supports
	  a two-lane UYVY sensor and packed YUYV buffers through V4L2.
